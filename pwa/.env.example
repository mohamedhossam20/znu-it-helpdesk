# Laravel backend the dev server proxies /api and /sanctum to
VITE_BACKEND_URL=http://localhost:8000

# Reverb (copy REVERB_APP_KEY from the backend .env; the key is public, the secret never comes here)
VITE_REVERB_APP_KEY=
# 127.0.0.1, not "localhost": reverb:start listens on IPv4 and browsers may resolve localhost to ::1
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
